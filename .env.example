# Server Configuration
PORT=8080
ENV=development
APP_NAME=flashsale-engine

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DB_NAME=flashsale_db

# Redis Configuration
# Managed providers can supply a redis:// or rediss:// URL instead.
REDIS_URL=
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Runtime Drivers
QUEUE_DRIVER=sqs
STORAGE_DRIVER=s3

# AWS / LocalStack Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT=http://localhost:4566
AWS_S3_BUCKET=flashsale-product-images
AWS_SQS_QUEUE_URL=http://localhost:4566/000000000000/flashsale-order-queue

# Firebase Auth Configuration
FIREBASE_DEV_MODE=true
FIREBASE_CREDENTIALS_PATH=

# Comma-separated browser origins. Never use * in production.
ALLOWED_ORIGINS=http://localhost:8080
